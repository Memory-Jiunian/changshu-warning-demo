{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "types": [
      "@figma/plugin-typings"
    ]
  },
  "include": [
    "src/**/*.ts"
  ]
}
